{
  "name": "vibe-hnindex",
  "version": "0.15.0",
  "workspaces": [
    "packages/*"
  ],
  "mcpName": "io.github.AndyAnh174/vibe-hnindex",
  "description": "MCP server for indexing and searching codebases with keyword + semantic search. Works with Claude, Cursor, Windsurf, Antigravity.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vibe-hnindex": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build -w hnindex-cli",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepack": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:perf": "node scripts/perf-compare.mjs",
    "bench:mcp": "node scripts/mcp-search-benchmark.mjs",
    "bench:quality": "node scripts/retrieval-quality.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qdrant/js-client-rest": "^1.13.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "13.0.3",
    "js-tiktoken": "^1.0.21",
    "minimatch": "^10.2.5",
    "typescript": "^5.9.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codebase",
    "knowledge-base",
    "search",
    "semantic-search",
    "qdrant",
    "sqlite",
    "fts5",
    "ollama",
    "bge-m3",
    "embeddings",
    "rag",
    "claude",
    "cursor",
    "windsurf",
    "antigravity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyAnh174/vibe-hnindex.git"
  },
  "homepage": "https://github.com/AndyAnh174/vibe-hnindex#readme",
  "bugs": {
    "url": "https://github.com/AndyAnh174/vibe-hnindex/issues"
  }
}
