{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AndyAnh174/vibe-hnindex",
  "description": "Index source code into a local knowledge base, search with keyword + semantic + hybrid modes.",
  "repository": {
    "url": "https://github.com/AndyAnh174/vibe-hnindex",
    "source": "github"
  },
  "version": "0.6.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "vibe-hnindex",
      "version": "0.6.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Ollama embedding server URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "OLLAMA_URL"
        },
        {
          "description": "Ollama embedding model name (default: bge-m3:567m)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "OLLAMA_MODEL"
        },
        {
          "description": "Qdrant vector database URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "QDRANT_URL"
        },
        {
          "description": "Qdrant API key (Qdrant Cloud or API-key-protected clusters)",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "QDRANT_API_KEY"
        },
        {
          "description": "SQLite database storage path",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "STORAGE_PATH"
        },
        {
          "description": "When true, omitting search mode uses auto (heuristic keyword/hybrid)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SEARCH_AUTO_ROUTE"
        },
        {
          "description": "When not false, keyword search with zero hits runs semantic fallback (default on)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SEARCH_KEYWORD_FALLBACK_SEMANTIC"
        }
      ]
    }
  ]
}
